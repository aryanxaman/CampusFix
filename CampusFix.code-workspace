{
  "folders": [
    {
      "name": "Frontend",
      "path": "src/main/webapp"
    },
    {
      "name": "Backend",
      "path": "src/main/java/edu/vit/campusfix"
    },
    {
      "name": "Database",
      "path": "database"
    },
    {
      "name": "Tests",
      "path": "src/test"
    },
    {
      "name": "Documentation",
      "path": "docs"
    },
    {
      "name": "Build & Run",
      "path": "scripts"
    },
    {
      "name": "CampusFix",
      "path": "."
    }
  ],
  "settings": {
    "terminal.integrated.cwd": "${workspaceFolder:CampusFix}",
    "workbench.iconTheme": "vs-seti",
    "workbench.tree.indent": 18,
    "workbench.tree.renderIndentGuides": "always",
    "explorer.sortOrder": "foldersFirst",
    "explorer.decorations.colors": false,
    "explorer.decorations.badges": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
      "pom.xml": "package.json, compose.yaml, .env.example, .editorconfig, .prettierrc.json, .gitignore, CampusFix.code-workspace, START-PREVIEW.cmd",
      "package.json": "package-lock.json, npm-shrinkwrap.json",
      "README.md": "TEAM-SETUP.md, PRESENTATION.md",
      "build-verification.json": "deployment-smoke-results.json, startup-fix-verification.json"
    },
    "files.exclude": {
      "Frontend": true,
      "Backend": true,
      "Tests": true,
      "src": true,
      "database": true,
      "docs": true,
      "scripts": true,
      "target": true,
      "**/hs_err_pid*.log": true,
      "**/replay_pid*.log": true,
      "**/__pycache__": true
    },
    "java.server.launchMode": "LightWeight",
    "java.jdt.ls.vmargs": "-Xms64m -Xmx512m -XX:+UseSerialGC -Dsun.zip.disableMemoryMapping=true",
    "java.autobuild.enabled": false,
    "java.maxConcurrentBuilds": 1
  }
}
